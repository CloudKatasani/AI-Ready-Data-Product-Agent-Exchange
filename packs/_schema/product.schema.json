{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DP-[A-Z]{2,4}-\\d{3}$"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "archetype": {
      "type": "string",
      "enum": [
        "SOURCE_ALIGNED",
        "AGGREGATE",
        "CONSUMER_ALIGNED",
        "ENTITY_MASTER"
      ]
    },
    "initial_status": {
      "type": "string",
      "enum": [
        "CERTIFIED",
        "IN_CERTIFICATION",
        "IN_DEVELOPMENT",
        "DRAFT"
      ]
    },
    "seed_stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "steward": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "decision": {
      "type": "object",
      "properties": {
        "persona": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "cadence": {
          "type": "string"
        },
        "workaround": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        }
      },
      "required": [
        "persona",
        "decision",
        "cadence",
        "workaround",
        "consequence"
      ],
      "additionalProperties": false
    },
    "sample_questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_view": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_ports": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "semantic",
              "sql",
              "api",
              "agent"
            ]
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "sla": {
      "type": "object",
      "properties": {
        "freshness_minutes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "availability_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_null_rate_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "freshness_minutes",
        "availability_pct",
        "max_null_rate_pct"
      ],
      "additionalProperties": false
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^KPI-[A-Z]{2,4}-[A-Z0-9-]+$"
      }
    },
    "upstream": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
      }
    },
    "consumers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_seed": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "string",
          "const": "auto"
        },
        "open_proposals": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "artifacts"
      ],
      "additionalProperties": false
    },
    "certification_script": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "initial": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^gate\\d+$"
              },
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "warn",
                  "fail"
                ]
              }
            },
            "fixes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^FIX-\\d+$"
                  },
                  "check": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "effect": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "overlay": {
                            "type": "string",
                            "const": "VERIFIED_QUERY"
                          },
                          "keys": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^VQ-[A-Z]{2,4}-\\d{3}$"
                            }
                          }
                        },
                        "required": [
                          "overlay",
                          "keys"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "policy_attach": {
                            "type": "object",
                            "properties": {
                              "policy": {
                                "type": "string"
                              },
                              "columns": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[a-z_][a-z0-9_]*$"
                                }
                              }
                            },
                            "required": [
                              "policy",
                              "columns"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "policy_attach"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "check",
                  "label",
                  "effect"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "initial",
            "fixes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "value_case": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^VC-[A-Z]{2,4}-\\d{3}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "domain",
    "archetype",
    "initial_status",
    "seed_stage",
    "version",
    "owner",
    "steward",
    "description",
    "purpose",
    "decision",
    "sample_questions",
    "semantic_view",
    "output_ports",
    "sla",
    "kpis",
    "upstream",
    "lifecycle_seed",
    "certification_script",
    "value_case"
  ],
  "additionalProperties": false
}
