{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answers": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KO-[A-Z]{2,4}-\\d{2}$"
          },
          "kpi": {
            "type": "string",
            "pattern": "^KPI-[A-Z]{2,4}-[A-Z0-9-]+$"
          },
          "question": {
            "type": "string"
          },
          "query": {
            "type": "object",
            "properties": {
              "view": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "metrics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "timeGrain": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "quarter",
                  "year"
                ]
              },
              "timeRange": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "last": {
                    "type": "object",
                    "properties": {
                      "n": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "day",
                          "month",
                          "quarter",
                          "year"
                        ]
                      }
                    },
                    "required": [
                      "n",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  "ytd": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "=",
                        "!=",
                        "in",
                        "not in",
                        ">",
                        "<",
                        ">=",
                        "<=",
                        "between"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "dimension",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "orderBy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "dir"
                  ],
                  "additionalProperties": false
                }
              },
              "limit": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "analysis": {
                "type": "string",
                "enum": [
                  "value",
                  "trend",
                  "rank",
                  "contribution",
                  "distribution",
                  "compare_target"
                ]
              }
            },
            "required": [
              "view",
              "metrics"
            ],
            "additionalProperties": false
          },
          "failure_by_layer": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "silver",
                "gold",
                "semantic",
                "glossary",
                "context",
                "governance"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "wrong",
                "unsafe",
                "ambiguous",
                "unverified"
              ]
            }
          },
          "declared_delta_pct": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "silver",
                "gold",
                "semantic",
                "glossary",
                "context",
                "governance"
              ]
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "id",
          "kpi",
          "question",
          "query",
          "failure_by_layer"
        ],
        "additionalProperties": false
      }
    },
    "gold_fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gold": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
          },
          "silver": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
          },
          "column_map": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "gold",
          "silver"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "answers",
    "gold_fallbacks"
  ],
  "additionalProperties": false
}
