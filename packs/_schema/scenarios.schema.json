{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^SC-[A-Z]{2,4}-\\d{3}$"
      },
      "agent": {
        "type": "string",
        "pattern": "^AG-[A-Z]{2,4}-\\d{3}$"
      },
      "pattern": {
        "type": "integer",
        "minimum": 1,
        "maximum": 15
      },
      "question": {
        "type": "string"
      },
      "paraphrases": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "kind": {
        "default": "answer",
        "type": "string",
        "enum": [
          "answer",
          "decline",
          "clarify",
          "redirect",
          "help"
        ]
      },
      "query": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "view": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "metrics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "timeGrain": {
                "type": "string",
                "enum": [
                  "day",
                  "week",
                  "month",
                  "quarter",
                  "year"
                ]
              },
              "timeRange": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "last": {
                    "type": "object",
                    "properties": {
                      "n": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "unit": {
                        "type": "string",
                        "enum": [
                          "day",
                          "month",
                          "quarter",
                          "year"
                        ]
                      }
                    },
                    "required": [
                      "n",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  "ytd": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "filters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "=",
                        "!=",
                        "in",
                        "not in",
                        ">",
                        "<",
                        ">=",
                        "<=",
                        "between"
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "dimension",
                    "op",
                    "value"
                  ],
                  "additionalProperties": false
                }
              },
              "orderBy": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "dir"
                  ],
                  "additionalProperties": false
                }
              },
              "limit": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "analysis": {
                "type": "string",
                "enum": [
                  "value",
                  "trend",
                  "rank",
                  "contribution",
                  "distribution",
                  "compare_target"
                ]
              }
            },
            "required": [
              "view",
              "metrics"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "answer": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "narrative": {
            "type": "string"
          },
          "chart": {
            "type": "string",
            "enum": [
              "bar",
              "line",
              "table",
              "kpi",
              "none"
            ]
          }
        },
        "required": [
          "headline",
          "narrative",
          "chart"
        ],
        "additionalProperties": false
      },
      "followups": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "redirect_to": {
        "type": "string",
        "pattern": "^AG-[A-Z]{2,4}-\\d{3}$"
      },
      "expect": {
        "default": {},
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "top": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "certified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "personas_expect": {
        "default": {},
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "answer",
                "decline",
                "clarify",
                "redirect",
                "help"
              ]
            },
            "rowFiltered": {
              "type": "boolean"
            },
            "masked": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "agent",
      "pattern",
      "question",
      "query",
      "answer"
    ],
    "additionalProperties": false
  }
}
