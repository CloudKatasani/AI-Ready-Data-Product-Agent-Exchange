{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^_?[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "depth": {
      "type": "string",
      "enum": [
        "deep",
        "standard",
        "draft"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$"
    },
    "industry": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "short": {
          "type": "string",
          "pattern": "^[A-Z]{2,5}$"
        },
        "hq": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "short",
        "hq",
        "description"
      ],
      "additionalProperties": false
    },
    "database": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}-[A-Z]{2}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "regions": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overridable": {
      "type": "object",
      "properties": {
        "regions": {
          "type": "boolean"
        },
        "companyName": {
          "type": "boolean"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "regions",
        "companyName",
        "terms"
      ],
      "additionalProperties": false
    },
    "home": {
      "type": "object",
      "properties": {
        "heroQuestion": {
          "type": "string",
          "minLength": 10
        },
        "heroAgent": {
          "type": "string",
          "pattern": "^AG-[A-Z]{2,4}-\\d{3}$"
        },
        "headlineKpis": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^KPI-[A-Z]{2,4}-[A-Z0-9-]+$"
          }
        },
        "theatreScenarios": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SC-[A-Z]{2,4}-\\d{3}$"
          }
        }
      },
      "required": [
        "heroQuestion",
        "heroAgent",
        "headlineKpis",
        "theatreScenarios"
      ],
      "additionalProperties": false
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "story_roles": {
      "type": "object",
      "properties": {
        "heroScenario": {
          "type": "string",
          "pattern": "^SC-[A-Z]{2,4}-\\d{3}$"
        },
        "certDemoProduct": {
          "type": "string",
          "pattern": "^DP-[A-Z]{2,4}-\\d{3}$"
        },
        "lifecycleDemoProduct": {
          "type": "string",
          "pattern": "^DP-[A-Z]{2,4}-\\d{3}$"
        },
        "incidentForStory": {
          "type": "string",
          "pattern": "^INC-[A-Z]{2,4}-[A-Z0-9-]+$"
        },
        "knockoutKpi": {
          "type": "string",
          "pattern": "^KPI-[A-Z]{2,4}-[A-Z0-9-]+$"
        },
        "qualityFixAgent": {
          "type": "string",
          "pattern": "^AG-[A-Z]{2,4}-\\d{3}$"
        }
      },
      "required": [
        "heroScenario",
        "certDemoProduct",
        "lifecycleDemoProduct",
        "incidentForStory",
        "knockoutKpi",
        "qualityFixAgent"
      ],
      "additionalProperties": false
    },
    "lint_terms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "depth",
    "code",
    "industry",
    "company",
    "database",
    "locale",
    "currency",
    "asOf",
    "seed",
    "regions",
    "overridable",
    "home",
    "icon",
    "hook",
    "story_roles"
  ],
  "additionalProperties": false
}
