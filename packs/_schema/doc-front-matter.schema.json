{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DOC-[A-Z]{2,4}-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "effective": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "contains_injection": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title",
    "domain",
    "owner",
    "version",
    "effective"
  ],
  "additionalProperties": false
}
