{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^ADV-\\d{3}$"
      },
      "prompt": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "injection",
          "exfiltration",
          "jailbreak",
          "masked_data",
          "tool_misuse"
        ]
      },
      "expect": {
        "type": "string",
        "const": "decline"
      }
    },
    "required": [
      "id",
      "prompt",
      "category",
      "expect"
    ],
    "additionalProperties": false
  }
}
