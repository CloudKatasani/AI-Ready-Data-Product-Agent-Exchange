// Keystone app-state model — see docs/build-spec/03-data-model.md.
// Models arrive phase by phase. Phase 2: Persona, Entitlement, QueryLog, AuditEvent, KnowledgeOverlay.
// Phase 3: AnswerRecord, AnswerFeedback. Phase 4: DataProduct, Agent, Decision, AccessRequest, DemandItem,
// DemandVote, QualityRuleResult, QualityScoreSnapshot.
//
// Prisma does not allow the datasource provider to come from an env var. SQLite is the default;
// Postgres support (DATABASE_PROVIDER=postgresql) is delivered in Phase 11 (docs/adr/0010-database-provider-switch.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Imported from the pack; one row per pack persona.
model Persona {
  id            String @id // e.g. "utilities:ops-manager-north"
  packId        String
  archetype     String // A|B|C|D|E
  name          String
  title         String
  domain        String
  rolesJson     String // Role[]
  rowFilterJson String? // {dimension, allowed[]}
  unmaskedJson  String // SensitiveClass[]
  avatarSeed    String

  @@index([packId])
}

model Entitlement {
  id          String    @id @default(cuid())
  personaId   String
  subjectType String // PRODUCT|AGENT
  subjectId   String
  purpose     String
  grantedVia  String // SEED|REQUEST
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([personaId])
}

/// Append-only (invariant I06): one row per QueryService.run().
model QueryLog {
  id             String   @id @default(cuid())
  personaId      String
  kind           String // preview|sql|metric
  purpose        String?
  sqlHash        String
  displaySql     String
  productIdsJson String
  policiesJson   String
  rowCount       Int
  elapsedMs      Int
  createdAt      DateTime @default(now())

  @@index([personaId])
}

/// Append-only, hash-chained: hash = sha256(prevHash + canonicalJson(event)).
model AuditEvent {
  id          String   @id @default(cuid())
  packId      String
  actorType   String // HUMAN|AGENT|SYSTEM
  actorId     String
  action      String
  subjectType String
  subjectId   String
  detailJson  String
  hash        String
  prevHash    String?
  createdAt   DateTime @default(now())

  @@index([packId])
}

model KnowledgeOverlay {
  id               String    @id @default(cuid())
  packId           String
  kind             String // SYNONYM|BUSINESS_RULE|VERIFIED_QUERY|INSTRUCTION|GLOSSARY_TERM
  key              String
  payloadJson      String
  version          Int       @default(1)
  createdBy        String
  sourceFeedbackId String?
  createdAt        DateTime  @default(now())
  supersededAt     DateTime?

  @@index([packId, kind])
}

/// Append-only (invariant I06): one row per agent answer (Ask, Home hero, Answer Theatre replays excluded).
model AnswerRecord {
  id              String   @id @default(cuid())
  packId          String
  agentId         String
  agentVersion    Int      @default(1)
  personaId       String
  question        String
  kind            String // answer|decline|clarify|redirect|help
  mode            String // scripted|live|live_fallback
  fallbackReason  String?
  scenarioId      String?
  metricQueryJson String?
  answerJson      String // full AgentAnswer
  citationsJson   String
  traceJson       String
  confidence      String // trusted|questionable|unsafe
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  costUsd         Float    @default(0)
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([packId, agentId])
}

model AnswerFeedback {
  id        String   @id @default(cuid())
  answerId  String
  personaId String
  rating    Int // +1 | -1
  reason    String?
  state     String // NEW|TRIAGED|FIXED|DISMISSED
  fixId     String?
  createdAt DateTime @default(now())

  @@index([answerId])
}

/// Live catalog record for a data product (seeded from the pack; lifecycle state from Phase 5).
model DataProduct {
  id                  String    @id // "DP-UTL-001"
  packId              String
  name                String
  domain              String
  archetype           String
  tier                String // bronze|silver|gold|platinum (rubric quality tiers)
  status              String // DRAFT|IN_DEVELOPMENT|IN_CERTIFICATION|CERTIFIED|DEPRECATED|RETIRED
  currentStage        Int       @default(1)
  semanticVersion     String    @default("0.1.0")
  ownerPersonaId      String
  stewardPersonaId    String?
  description         String
  purpose             String
  decisionJson        String
  sampleQuestionsJson String
  semanticView        String?
  outputPortsJson     String
  slaJson             String
  sensitivityJson     String // SensitiveClass[]
  kpiIdsJson          String
  upstreamJson        String
  fromPack            Boolean   @default(true)
  isCertDemo          Boolean   @default(false)
  publishedAt         DateTime?
  retiredAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accessRequests AccessRequest[]
  qualityScores  QualityScoreSnapshot[]

  @@index([packId])
}

model Agent {
  id             String   @id // "AG-UTL-001"
  packId         String
  family         String // DOMAIN|LIFECYCLE|PLATFORM
  name           String
  domain         String?
  status         String // DRAFT|PILOT|CANARY|PRODUCTION|RETIRED
  ownerPersonaId String
  manifestJson   String
  currentVersion Int      @default(1)
  fromPack       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([packId])
}

/// ONLY written by recordDecision() (invariant I04).
model Decision {
  id          String   @id @default(cuid())
  packId      String
  subjectType String // GATE|ACCESS_REQUEST|AGENT_PUBLISH|PRODUCT_CERTIFY|TRIAGE
  subjectId   String
  gateId      String?
  personaId   String // a human persona, or "<pack>:system" for policy auto-approval
  role        String
  outcome     String // APPROVE|REJECT|VETO
  rationale   String
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
}

model AccessRequest {
  id                String       @id @default(cuid())
  packId            String
  productId         String?
  agentId           String?
  requesterId       String
  purpose           String
  justification     String
  durationDays      Int
  policyPreviewJson String
  state             String // PENDING|GRANTED|DENIED|EXPIRED|REVOKED
  createdAt         DateTime     @default(now())
  product           DataProduct? @relation(fields: [productId], references: [id])

  @@index([packId, state])
}

model DemandItem {
  id              String   @id // "DM-UTL-001" (pack) or generated
  packId          String
  kind            String // PRODUCT|AGENT|KPI
  title           String
  description     String
  votes           Int      @default(0)
  state           String // OPEN|IN_INTAKE|DELIVERED|DECLINED
  linkedRequestId String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([packId])
}

model DemandVote {
  id        String   @id @default(cuid())
  demandId  String
  personaId String
  createdAt DateTime @default(now())

  @@unique([demandId, personaId])
}

model QualityRuleResult {
  id          String   @id @default(cuid())
  productId   String
  ruleId      String
  dimension   String
  passed      Boolean
  observed    Float?
  threshold   Float
  evaluatedAt DateTime @default(now())

  @@index([productId])
}

model QualityScoreSnapshot {
  id             String      @id @default(cuid())
  productId      String
  score          Float
  dimensionsJson String
  rubricVersion  String
  createdAt      DateTime    @default(now())
  product        DataProduct @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}
