// Keystone app-state model — see docs/build-spec/03-data-model.md.
// Models arrive phase by phase. Phase 2: Persona, Entitlement, QueryLog, AuditEvent, KnowledgeOverlay.
// Phase 3: AnswerRecord, AnswerFeedback. Phase 4: DataProduct, Agent, Decision, AccessRequest, DemandItem,
// DemandVote, QualityRuleResult, QualityScoreSnapshot. Phase 5: lifecycle (StageRun, Gate, GateEvidence,
// Artifact, ArtifactVersion, FieldProvenance, Comment, Task, ChangeRequest, CertificationCheckResult,
// AppliedFix), lifecycle agents (AgentAction, AgentProposal, AutopilotRun, AgentSetting), ProductRequest.
//
// Prisma does not allow the datasource provider to come from an env var. SQLite is the default;
// Postgres: `pnpm db:pg:prepare` renders prisma/postgres/schema.prisma (docs/adr/0010-database-provider-switch.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Imported from the pack; one row per pack persona.
model Persona {
  id            String @id // e.g. "utilities:ops-manager-north"
  packId        String
  archetype     String // A|B|C|D|E
  name          String
  title         String
  domain        String
  rolesJson     String // Role[]
  rowFilterJson String? // {dimension, allowed[]}
  unmaskedJson  String // SensitiveClass[]
  avatarSeed    String

  @@index([packId])
}

model Entitlement {
  id          String    @id @default(cuid())
  personaId   String
  subjectType String // PRODUCT|AGENT
  subjectId   String
  purpose     String
  grantedVia  String // SEED|REQUEST
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([personaId])
}

/// Append-only (invariant I06): one row per QueryService.run().
model QueryLog {
  id             String   @id @default(cuid())
  personaId      String
  kind           String // preview|sql|metric
  purpose        String?
  sqlHash        String
  displaySql     String
  productIdsJson String
  policiesJson   String
  rowCount       Int
  elapsedMs      Int
  createdAt      DateTime @default(now())

  @@index([personaId])
}

/// Append-only, hash-chained: hash = sha256(prevHash + canonicalJson(event)).
model AuditEvent {
  id          String   @id @default(cuid())
  packId      String
  actorType   String // HUMAN|AGENT|SYSTEM
  actorId     String
  action      String
  subjectType String
  subjectId   String
  detailJson  String
  hash        String
  /// Unique: an event has at most one successor, so concurrent appends cannot fork the chain.
  prevHash    String?  @unique
  createdAt   DateTime @default(now())

  @@index([packId])
}

model KnowledgeOverlay {
  id               String    @id @default(cuid())
  packId           String
  kind             String // SYNONYM|BUSINESS_RULE|VERIFIED_QUERY|INSTRUCTION|GLOSSARY_TERM
  key              String
  payloadJson      String
  version          Int       @default(1)
  createdBy        String
  sourceFeedbackId String?
  createdAt        DateTime  @default(now())
  supersededAt     DateTime?

  @@index([packId, kind])
}

/// Append-only (invariant I06): one row per agent answer (Ask, Home hero, Answer Theatre replays excluded).
model AnswerRecord {
  id              String   @id @default(cuid())
  packId          String
  agentId         String
  agentVersion    Int      @default(1)
  personaId       String
  question        String
  kind            String // answer|decline|clarify|redirect|help
  mode            String // scripted|live|live_fallback
  fallbackReason  String?
  scenarioId      String?
  metricQueryJson String?
  answerJson      String // full AgentAnswer
  citationsJson   String
  traceJson       String
  confidence      String // trusted|questionable|unsafe
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  costUsd         Float    @default(0)
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([packId, agentId])
}

model AnswerFeedback {
  id        String   @id @default(cuid())
  answerId  String
  personaId String
  rating    Int // +1 | -1
  reason    String?
  state     String // NEW|TRIAGED|FIXED|DISMISSED
  fixId     String?
  createdAt DateTime @default(now())

  @@index([answerId])
}

/// Live catalog record for a data product (seeded from the pack; lifecycle state from Phase 5).
model DataProduct {
  id                  String    @id // "DP-UTL-001"
  packId              String
  name                String
  domain              String
  archetype           String
  tier                String // bronze|silver|gold|platinum (rubric quality tiers)
  status              String // DRAFT|IN_DEVELOPMENT|IN_CERTIFICATION|CERTIFIED|DEPRECATED|RETIRED
  currentStage        Int       @default(1)
  semanticVersion     String    @default("0.1.0")
  ownerPersonaId      String
  stewardPersonaId    String?
  description         String
  purpose             String
  decisionJson        String
  sampleQuestionsJson String
  semanticView        String?
  outputPortsJson     String
  slaJson             String
  sensitivityJson     String // SensitiveClass[]
  kpiIdsJson          String
  upstreamJson        String
  fromPack            Boolean   @default(true)
  isCertDemo          Boolean   @default(false)
  publishedAt         DateTime?
  retiredAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accessRequests AccessRequest[]
  qualityScores  QualityScoreSnapshot[]

  @@index([packId])
}

model Agent {
  id             String   @id // "AG-UTL-001"
  packId         String
  family         String // DOMAIN|LIFECYCLE|PLATFORM
  name           String
  domain         String?
  status         String // DRAFT|PILOT|CANARY|PRODUCTION|RETIRED
  ownerPersonaId String
  manifestJson   String
  currentVersion Int      @default(1)
  fromPack       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([packId])
}

/// ONLY written by recordDecision() (invariant I04).
model Decision {
  id          String   @id @default(cuid())
  packId      String
  subjectType String // GATE|ACCESS_REQUEST|AGENT_PUBLISH|PRODUCT_CERTIFY|TRIAGE
  subjectId   String
  gateId      String?
  personaId   String // a human persona, or "<pack>:system" for policy auto-approval
  role        String
  outcome     String // APPROVE|REJECT|VETO
  rationale   String
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId])
}

model AccessRequest {
  id                String       @id @default(cuid())
  packId            String
  productId         String?
  agentId           String?
  requesterId       String
  purpose           String
  justification     String
  durationDays      Int
  policyPreviewJson String
  state             String // PENDING|GRANTED|DENIED|EXPIRED|REVOKED
  createdAt         DateTime     @default(now())
  product           DataProduct? @relation(fields: [productId], references: [id])

  @@index([packId, state])
}

model DemandItem {
  id              String   @id // "DM-UTL-001" (pack) or generated
  packId          String
  kind            String // PRODUCT|AGENT|KPI
  title           String
  description     String
  votes           Int      @default(0)
  state           String // OPEN|IN_INTAKE|DELIVERED|DECLINED
  linkedRequestId String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([packId])
}

model DemandVote {
  id        String   @id @default(cuid())
  demandId  String
  personaId String
  createdAt DateTime @default(now())

  @@unique([demandId, personaId])
}

model QualityRuleResult {
  id          String   @id @default(cuid())
  productId   String
  ruleId      String
  dimension   String
  passed      Boolean
  observed    Float?
  threshold   Float
  evaluatedAt DateTime @default(now())

  @@index([productId])
}

model QualityScoreSnapshot {
  id             String      @id @default(cuid())
  productId      String
  score          Float
  dimensionsJson String
  rubricVersion  String
  createdAt      DateTime    @default(now())
  product        DataProduct @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
}

// ───────── Lifecycle (06) ─────────
model StageRun {
  id          String    @id @default(cuid())
  productId   String
  stage       Int
  attempt     Int       @default(1)
  state       String // NOT_STARTED|IN_PROGRESS|IN_REVIEW|COMPLETE
  startedAt   DateTime?
  completedAt DateTime?

  @@index([productId, stage])
}

model Gate {
  id                String         @id @default(cuid())
  productId         String
  stage             Int
  state             String // PENDING|IN_REVIEW|APPROVED|REJECTED|STALE
  quorum            Int
  requiredRolesJson String
  vetoRolesJson     String
  staleReason       String?
  submittedBy       String?
  submittedAt       DateTime?
  updatedAt         DateTime       @updatedAt
  evidence          GateEvidence[]

  @@unique([productId, stage])
}

/// Append-only snapshot of the artifact versions a gate decision relied on.
model GateEvidence {
  id                String   @id @default(cuid())
  gateId            String
  artifactVersionId String
  artifactType      String
  contentHash       String
  createdAt         DateTime @default(now())
  gate              Gate     @relation(fields: [gateId], references: [id])

  @@index([gateId])
}

model Artifact {
  id        String            @id @default(cuid())
  productId String
  type      String // registry key
  stage     Int
  versions  ArtifactVersion[]

  @@unique([productId, type])
}

/// Append-only, content-hashed (invariant I06).
model ArtifactVersion {
  id          String            @id @default(cuid())
  artifactId  String
  version     Int
  contentJson String
  contentHash String
  committedBy String // personaId
  message     String
  createdAt   DateTime          @default(now())
  provenance  FieldProvenance[]
  artifact    Artifact          @relation(fields: [artifactId], references: [id])

  @@unique([artifactId, version])
}

model FieldProvenance {
  id         String          @id @default(cuid())
  versionId  String
  fieldPath  String
  source     String // HUMAN|AGENT
  agentId    String?
  acceptedBy String?
  version    ArtifactVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
}

model Comment {
  id         String    @id @default(cuid())
  productId  String
  stage      Int
  fieldPath  String?
  authorType String // HUMAN|AGENT
  authorId   String
  body       String
  parentId   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, stage])
}

model Task {
  id           String    @id @default(cuid())
  packId       String
  productId    String?
  kind         String // REAPPROVE|REVIEW|FIX
  title        String
  assigneeRole String
  state        String // OPEN|DONE
  dueAt        DateTime?
  createdAt    DateTime  @default(now())

  @@index([packId, state])
}

model ChangeRequest {
  id                 String   @id @default(cuid())
  productId          String
  severity           String
  versionBump        String // major|minor|patch
  affectedStagesJson String
  description        String
  state              String
  createdAt          DateTime @default(now())
}

model CertificationCheckResult {
  id          String   @id @default(cuid())
  productId   String
  checkId     String
  status      String // pass|warn|fail
  detail      String
  fixApplied  Boolean  @default(false)
  evaluatedAt DateTime @default(now())

  @@index([productId, checkId])
}

/// Append-only record of a certification fix applied in the demo (its effects are real state).
model AppliedFix {
  id        String   @id @default(cuid())
  packId    String
  productId String
  fixId     String
  appliedBy String
  createdAt DateTime @default(now())

  @@unique([packId, productId, fixId])
}

// ───────── Lifecycle agents (08 §7) ─────────
/// Append-only (invariant I06).
model AgentAction {
  id                 String   @id @default(cuid())
  packId             String
  agentId            String
  productId          String?
  stage              Int?
  trigger            String // MANUAL|AUTOPILOT|STAGE_ENTRY|MONITOR
  scopeJson          String
  inputHash          String
  model              String
  provider           String // anthropic|heuristic
  tokensIn           Int      @default(0)
  tokensOut          Int      @default(0)
  costUsd            Float    @default(0)
  outputJson         String
  redactedFieldsJson String   @default("[]")
  disposition        String // PROPOSED|NO_CHANGE|FAILED
  createdAt          DateTime @default(now())

  @@index([productId, stage])
}

model AgentProposal {
  id           String    @id @default(cuid())
  actionId     String
  productId    String
  stage        Int
  artifactType String
  fieldPath    String
  proposedJson String
  acceptedJson String?
  rationale    String
  state        String // OPEN|ACCEPTED|EDITED|REJECTED
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([productId, state])
}

model AutopilotRun {
  id        String   @id @default(cuid())
  productId String
  mode      String // automated|manual
  state     String // RUNNING|AWAITING_REVIEW|AWAITING_GATE|COMPLETED|CANCELLED
  stepsJson String
  startedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentSetting {
  id       String @id @default(cuid())
  packId   String
  agentId  String
  autonomy String // L0|L1|L2|L3

  @@unique([packId, agentId])
}

// ───────── Intake (06 §7) ─────────
model ProductRequest {
  id                      String   @id @default(cuid())
  reference               String   @unique // REQ-UTL-001
  packId                  String
  title                   String
  requesterId             String
  state                   String // SUBMITTED|TRIAGE|APPROVED|MERGED|DECLINED
  decisionJson            String
  questionsJson           String
  stakes                  String
  freshness               String
  duplicateCandidatesJson String
  mergedIntoId            String?
  createdProductId        String?
  declineReason           String?
  slaDueAt                DateTime
  createdAt               DateTime @default(now())

  @@index([packId, state])
}

// ───────── Agent Factory, evaluation, publish gate, release (08 §5–6) ─────────
model AgentVersion {
  id               String   @id @default(cuid())
  agentId          String
  version          Int
  manifestJson     String
  manifestHash     String
  instructionsHash String
  releaseState     String // candidate|canary|live|rolled_back
  canaryPct        Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([agentId, version])
}

model PublishGateRun {
  id           String   @id @default(cuid())
  agentId      String
  agentVersion Int
  resultsJson  String
  passed       Boolean
  createdAt    DateTime @default(now())

  @@index([agentId])
}

model EvalRun {
  id           String           @id @default(cuid())
  packId       String
  agentId      String
  agentVersion Int
  mode         String
  suitesJson   String // per suite: score, n, threshold, passed
  overall      Float
  createdAt    DateTime         @default(now())
  cases        EvalCaseResult[]

  @@index([agentId])
}

model EvalCaseResult {
  id           String  @id @default(cuid())
  runId        String
  suite        String
  caseId       String
  question     String
  expectedJson String
  actualJson   String
  pass         Boolean
  reason       String?
  run          EvalRun @relation(fields: [runId], references: [id])
}

// ───────── Operate (Phase 7) ─────────

/// A "Break something" incident opened from a pack template. Effects apply while state ≠ RESOLVED.
model Incident {
  id             String    @id @default(cuid())
  packId         String
  templateId     String
  title          String
  severity       String // SEV1|SEV2|SEV3
  state          String // OPEN|MITIGATED|RESOLVED
  affectedJson   String // { objects, products, agents }
  effectsJson    String // { kind, params, object, column }
  openedBy       String
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  postmortemJson String?

  @@index([packId, state])
}

/// One applied agent-quality fix (feedback → knowledge overlay) with the eval it moved.
model QualityFixRun {
  id           String   @id @default(cuid())
  packId       String
  agentId      String
  feedbackId   String?
  overlayId    String
  fixType      String // SYNONYM|BUSINESS_RULE|VERIFIED_QUERY|INSTRUCTION
  evalBefore   Float
  evalAfter    Float
  appliedBy    String
  createdAt    DateTime @default(now())

  @@index([packId, agentId])
}

// ───────── Strategy (Phase 8) ─────────

/// A named readiness assessment (answers to the 21 ported questions) with its computed scores.
model ReadinessAssessment {
  id          String   @id @default(cuid())
  packId      String
  name        String
  answersJson String
  scoresJson  String
  band        String
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([packId])
}

/// A human override of a product's prioritisation score, with the reason (advisory scoring, ADPM).
model PrioritisationOverride {
  id        String   @id @default(cuid())
  packId    String
  productId String
  model     String // WSJF|RICE
  score     Float
  reason    String
  personaId String
  createdAt DateTime @default(now())

  @@index([packId, productId])
}

// ───────── Presenter (Phase 9) ─────────

/// What a presenter launches: pack + branding + terminology + story + agent mode (09 §4). Never restored by
/// a reset — the profile and its branding survive it (AC1.4).
model DemoProfile {
  id          String    @id @default(cuid())
  name        String
  packId      String
  brandJson   String // { productName, companyName, logoDataUrl?, primary, accent }
  termsJson   String // display-only overrides { from: to }
  storyId     String?
  agentMode   String    @default("scripted")
  locked      Boolean   @default(false)
  archivedAt  DateTime?
  snapshotAt  DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}
